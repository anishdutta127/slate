# ===========================================================================
# Slate — environment variables
# ===========================================================================
# Copy to .env.local for local dev: `cp .env.example .env.local`
# Never commit .env.local — it is gitignored.

# ---------------------------------------------------------------------------
# M0 (scaffold) — only this section is consumed today
# ---------------------------------------------------------------------------

# Show /style guide on a non-localhost deploy (e.g. Vercel preview).
# Leave unset to hide /style anywhere NODE_ENV === 'production'.
# Set to "1" to show it on preview deploys. Never set in production.
SLATE_ENABLE_STYLE_GUIDE=

# Public app URL — used by canonical links and og:url. Required from M1 onward.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# M3 and beyond — placeholders so future devs know what's coming
# ---------------------------------------------------------------------------

# Neon Postgres (M3)
DATABASE_URL=
DIRECT_DATABASE_URL=

# Cloudflare R2 media (M3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=slate-media
R2_PUBLIC_URL=

# Better Auth sessions (M3)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Firebase Phone Auth — server-side (firebase-admin) (M3)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Phone Auth — client-side (Web SDK) (M3)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
