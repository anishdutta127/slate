# ===========================================================================
# Slate — environment variables
# ===========================================================================
# Copy to .env.local for local dev: `cp .env.example .env.local`
# Never commit .env.local — it is gitignored.

# ---------------------------------------------------------------------------
# M0 (scaffold) — only this section is consumed today
# ---------------------------------------------------------------------------

# Show /style guide on a non-localhost deploy (e.g. Vercel preview).
# Leave unset to hide /style anywhere NODE_ENV === 'production'.
# Set to "1" to show it on preview deploys. Never set in production.
SLATE_ENABLE_STYLE_GUIDE=

# Phase 1 dev-login (M0.5+). Set to "1" on preview deploys so /login + the
# POST /api/auth/sign-in-with-phone endpoint work without OTP. Never in prod.
SLATE_ALLOW_DEV_LOGIN=

# Public app URL — used by canonical links and og:url.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# M0.5 — Neon + Better Auth (required from M0.5 onward)
# ---------------------------------------------------------------------------

# Neon Postgres. DATABASE_URL = pooled (for serverless runtime), DIRECT = non-pooled
# (for migrations). Both required from M0.5 onward.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Better Auth sessions. SECRET: generate with `openssl rand -hex 32`.
# URL: localhost in dev, your preview domain or slate.club in prod.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Local-dev DoH fallback. Set to "1" only on networks where the ISP refuses
# DNS for Neon's AWS subdomains (Reliance Jio observed). No-op on Vercel.
SLATE_USE_DOH=

# ---------------------------------------------------------------------------
# M3 and beyond — placeholders
# ---------------------------------------------------------------------------

# Cloudflare R2 media (M3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=slate-media
R2_PUBLIC_URL=

# Firebase Phone Auth — Phase 2 of auth, wires in pre-launch (M3)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
